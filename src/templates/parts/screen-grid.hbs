<div class="gm-screen-container tab {{grid.cssClass}} {{#if (lookup @root/tabColors grid.tabColor)}}has-tab-color{{/if}}" data-tab="{{grid.id}}" data-group="gmScreen-primary"{{#if (lookup @root/tabColors grid.tabColor)}} style="--gm-tab-color: {{lookup @root/tabColors grid.tabColor}}"{{/if}}>
  <div class="gm-screen-grid"
    style="grid-template-columns: repeat({{#if grid.columnOverride}}{{grid.columnOverride}}{{else}}{{@root/columns}}{{/if}}, 1fr); grid-template-rows: repeat({{#if grid.rowOverride}}{{grid.rowOverride}}{{else}}{{@root/rows}}{{/if}}, 1fr);">

    {{#each gridEntries}}
    {{> 'modules/gm-screen-risi/templates/parts/screen-cell.hbs' gridId=../grid.id}}
    {{/each}}
  </div>
</div>