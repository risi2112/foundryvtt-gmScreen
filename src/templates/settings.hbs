<div>

  <h2>{{localize 'GMSCR.gridConfig.GridTabs'}}</h2>

  <table>
    <thead>
      <tr>
        <th>{{localize 'GMSCR.gridConfig.table.TabOrder'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.TabLabel'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.Columns'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.Rows'}}</th>
        <th data-tooltip="{{localize 'GMSCR.gridConfig.table.RowHint'}}">{{localize 'GMSCR.gridConfig.table.Row'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.Color'}}</th>
        <th data-tooltip="{{localize 'GMSCR.gridConfig.table.JournalViewHint'}}">{{localize 'GMSCR.gridConfig.table.JournalView'}}</th>
        <th>{{localize 'GMSCR.gridConfig.table.Shared'}}</th>
        <th>{{localize 'Delete'}}</th>
      </tr>
    </thead>

    <tbody>
      {{#each settings.grids as | grid id |}}
      {{> 'modules/gm-screen-risi/templates/parts/settings-grid-config-table-row.hbs' gridId=id grid=grid
      defaultColumns=@root/defaultColumns
      defaultRows=@root/defaultRows
      tabColorChoices=@root/tabColorChoices
      tabColors=@root/tabColors
      journalViewChoices=@root/journalViewChoices
      tabRowChoices=@root/tabRowChoices}}
      {{/each}}
    </tbody>
  </table>

  <div class="flexrow">
    <button type="button" data-table="grids" class="add-row">
      <i class="fa fa-plus"></i> <span>{{localize 'GMSCR.gridConfig.table.Add'}}</span>
    </button>

    <button type='submit'><i class="fa fa-save"></i> {{localize 'Save Changes'}}</button>
  </div>
</div>
