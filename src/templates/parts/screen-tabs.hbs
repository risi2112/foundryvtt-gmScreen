<div class='gm-screen-actions sheet-tabs tabs' data-application-part="tabs" aria-roledescription="{{localize "SHEETS.FormNavLabel"}}">

  <div class="gm-screen-tabs-scroller tab-overflow-{{tabOverflow}}">
    <button type='button' class="gm-screen-tabs-arrow prev" data-action="scrollTabsPrev" tabindex="-1"
        aria-label="{{localize 'GMSCR.gmScreen.ScrollTabsLeft'}}"><i class="fas fa-chevron-left"></i></button>
    <div class="gm-screen-tabs">
      {{#each tabs as |tab|}}
      <button type='button' data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}"
          class="{{tab.cssClass}} {{#if tab.color}}has-tab-color{{/if}}"
          {{#if tab.color}}style="--gm-tab-color: {{tab.color}}"{{/if}}
          {{#if tab.tooltip}}data-tooltip="{{tab.tooltip}}"{{/if}}>
          {{#if tab.label}}{{localize tab.label}}{{/if}}
      </button>
      {{/each}}
    </div>
    <button type='button' class="gm-screen-tabs-arrow next" data-action="scrollTabsNext" tabindex="-1"
        aria-label="{{localize 'GMSCR.gmScreen.ScrollTabsRight'}}"><i class="fas fa-chevron-right"></i></button>
  </div>
  {{#if displayDrawer}}
  <div class="meta-actions">
    {{#if isGM}}
    <button class="clear" type='button' data-action="clearGrid" title={{localize 'GMSCR.gmScreen.Reset' }}><i
        class="fas fa-ban"></i></button>
    {{/if}}
    <button class="refresh" type='button' data-action="refresh" title={{localize 'GMSCR.gmScreen.Refresh' }}><i
        class="fas fa-sync"></i></button>
  </div>

  <button class="gm-screen-button" data-action="toggle-gm-screen"><i class="fas fa-book-reader"></i>
    {{#unless condensedButton}}
    {{#if isGM}}
    {{localize 'GMSCR.gmScreen.Open' }}
    {{else}}
    {{ localize 'GMSCR.gmScreen.OpenPlayer' }}
    {{/if}}
    {{/unless}}
  </button>
  {{/if}}

</div>
